generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  CONTACT
  POLL
  SYSTEM
  LOCATION
  STICKER
}

enum ContactStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum LastSeenPrivacy {
  EVERYONE
  CONTACTS
  NOBODY
}

// A per-user exception to that user's lastSeenPrivacy setting: ALLOW always
// shows their last-seen time to this one other user regardless of the global
// setting, DENY always hides it from them.
enum LastSeenExceptionMode {
  ALLOW
  DENY
}

enum GroupAddPrivacy {
  EVERYONE
  CONTACTS
  NOBODY
}

enum MessagePrivacy {
  EVERYONE
  CONTACTS
  NOBODY
}

// Per-conversation override of the user's global hideNotificationContent
// setting: DEFAULT follows the global setting, SHOW always includes the
// preview, HIDE always shows a generic "new message" notification.
enum NotificationPreview {
  DEFAULT
  SHOW
  HIDE
}

// Per-conversation override of the user's global readReceiptsEnabled
// setting: DEFAULT follows the global setting, ON always sends read
// receipts in this chat, OFF never sends them in this chat.
enum ReadReceiptsOverride {
  DEFAULT
  ON
  OFF
}

enum ReportReason {
  SPAM
  HARASSMENT
  VIOLENCE
  ILLEGAL_CONTENT
  IMPERSONATION
  OTHER
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  username     String   @unique
  // Set when the username is changed; used to enforce the change cooldown.
  usernameChangedAt DateTime?
  displayName  String
  passwordHash String
  avatarUrl    String?
  bio          String?
  // Short custom status line (e.g. "📚 Mashg'ulotda", "🏖 Ta'tilda"), shown on
  // the user's profile separately from their bio.
  customStatus String?
  // When set, customStatus is automatically cleared once this time passes.
  customStatusExpiresAt DateTime?
  // Base64 X25519 public key used by clients for end-to-end encryption.
  // The matching private key never leaves the user's device.
  publicKey    String
  lastSeenAt   DateTime @default(now())
  // Who can see this user's lastSeenAt timestamp.
  lastSeenPrivacy LastSeenPrivacy @default(EVERYONE)
  // Who can see this user's avatarUrl. Hidden users fall back to the
  // initials placeholder on the viewer's side.
  avatarPrivacy LastSeenPrivacy @default(EVERYONE)
  // Who can see this user's bio/about text.
  bioPrivacy LastSeenPrivacy @default(EVERYONE)
  // Birthday (day-of-month and month only, no year, to avoid revealing age).
  birthdayDay   Int?
  birthdayMonth Int?
  // Who can see this user's birthday.
  birthdayPrivacy LastSeenPrivacy @default(CONTACTS)
  // Who can add this user to a group directly (without an invite link).
  groupAddPrivacy GroupAddPrivacy @default(EVERYONE)
  // Who can start a new direct conversation with this user. Doesn't affect
  // conversations that already exist.
  messagePrivacy MessagePrivacy @default(EVERYONE)
  // Who can find this user by their exact phone number via search.
  phoneNumberPrivacy LastSeenPrivacy @default(EVERYONE)
  // Who can see this user's name/profile link as the original sender when
  // someone else forwards their message ("Forwarded from <name>"). Denied
  // viewers see the message forwarded anonymously, same as the sender
  // manually choosing "Muallifni yashirish".
  forwardedMessagePrivacy LastSeenPrivacy @default(EVERYONE)
  // When false, this user's read receipts ("seen" status) are hidden from
  // others in direct chats, and they likewise can't see others' read receipts.
  readReceiptsEnabled Boolean @default(true)
  // When false, this user's typing/recording indicators are not sent to others.
  typingIndicatorsEnabled Boolean @default(true)
  // Global push notification toggles. A muted conversation always stays silent
  // regardless of these; mentions and replies are still delivered even when
  // notifyGroupChats/notifyPrivateChats is off.
  notifyPrivateChats Boolean @default(true)
  notifyGroupChats   Boolean @default(true)
  notifyReactions    Boolean @default(true)
  // When false, @-mentions no longer bypass mute settings or send a special
  // "mentioned you" notification - they're treated as regular messages.
  notifyMentions     Boolean @default(true)
  // When true, push notifications show a generic "new message" label instead
  // of the sender's name and message preview - useful for lock-screen privacy.
  hideNotificationContent Boolean @default(false)
  // Whether muted chats still count toward the app icon's unread badge and the
  // chat list's folder unread counters.
  includeMutedInBadge Boolean @default(true)
  // "Do not disturb": push notifications (incl. mentions and replies) are
  // suppressed during this daily window, in the user's local time.
  quietHoursEnabled Boolean @default(false)
  // Minutes since midnight (0-1439), in the user's local time.
  quietHoursStart   Int?
  quietHoursEnd     Int?
  // User's UTC offset in minutes (e.g. 300 for UTC+5), captured from the device.
  quietHoursTimezoneOffset Int?
  // Global "Do not disturb": when notificationsPaused is true, or
  // notificationsPausedUntil is in the future, ALL push notifications for new
  // messages (incl. @-mentions and replies) are suppressed - mirrors the
  // isMuted/mutedUntil pair used for per-conversation mutes.
  notificationsPaused      Boolean   @default(false)
  notificationsPausedUntil DateTime?
  // Default "disappearing messages" timer (in seconds), automatically applied
  // to new conversations this user starts. Null means messages persist normally.
  defaultDisappearingSeconds Int?
  // Number of days of inactivity (no login/connection) after which this
  // account is automatically deleted. Mirrors Telegram's "self-destruct" setting.
  selfDestructDays Int @default(180)
  // Optional second ("cloud") password, required after the account password
  // when logging in. Null means two-step verification is disabled.
  twoFactorHash String?
  twoFactorHint String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  participants     ConversationParticipant[]
  messages         Message[]
  reactions        MessageReaction[]
  starredMessages  MessageStar[]
  messageReminders MessageReminder[]
  pollVotes        PollVote[]
  sentContacts     Contact[]                  @relation("ContactOwner")
  receivedContacts Contact[]                  @relation("ContactTarget")
  blockedUsers     BlockedUser[]              @relation("BlockOwner")
  blockedByUsers   BlockedUser[]              @relation("BlockTarget")
  onlineNotifyRequestsOwned    OnlineNotifyRequest[] @relation("OnlineNotifyOwner")
  onlineNotifyRequestsTargeted OnlineNotifyRequest[] @relation("OnlineNotifyTarget")
  lastSeenExceptionsOwned      LastSeenException[]   @relation("LastSeenExceptionOwner")
  lastSeenExceptionsTargeted   LastSeenException[]   @relation("LastSeenExceptionTarget")
  pushTokens       PushToken[]
  chatFolders      ChatFolder[]
  reportsMade      Report[]                   @relation("ReportReporter")
  reportsReceived  Report[]                   @relation("ReportReported")
  groupJoinRequests GroupJoinRequest[]
  broadcastLists   BroadcastList[]
  usernameHistory  UsernameHistory[]
  dismissedSuggestions DismissedSuggestion[] @relation("DismissedSuggestionOwner")
  stories          Story[]
  storyViews       StoryView[]
  deviceKeys       DeviceKey[]
  isAdmin          Boolean          @default(false)
  isVerified       Boolean          @default(false)
  verifiedType     String?
  walletBalance    Decimal          @default(0) @db.Decimal(18, 2)
  sentPayments     Payment[]        @relation("PaymentSender")
  receivedPayments Payment[]        @relation("PaymentReceiver")
  miniApps         MiniApp[]
  outgoingCalls    CallLog[]        @relation("CallCaller")
  incomingCalls    CallLog[]        @relation("CallReceiver")
  posts            Post[]
  postLikes        PostLike[]
  postComments     PostComment[]
  stores           Store[]
  orders           Order[]
  sentRedPackets   RedPacket[]  @relation("RedPacketSender")
  claimedRedPackets RedPacket[] @relation("RedPacketClaimer")
  stickerPacks     StickerPack[] @relation("StickerPackCreator")
  installedPacks   StickerPackInstall[]
  storyHighlights  StoryHighlight[]
  qrPaymentsCreated QrPayment[] @relation("QrPaymentCreator")
  qrPaymentsPaid    QrPayment[] @relation("QrPaymentPayer")
  nearbyLocation   NearbyLocation?
  bots             Bot[]
  reels            Reel[]
  reelLikes        ReelLike[]
  reelComments     ReelComment[]
  forumTopics      ForumTopic[]
  hostedVoiceRooms VoiceRoom[] @relation("VoiceRoomHost")
  voiceRoomParticipations VoiceRoomParticipant[]
  liveStreams       LiveStream[]
  sharedThemes     SharedTheme[]
  communities      Community[]
  events           Event[]
  eventRsvps       EventRsvp[]
  channelSubscriptions ChannelSubscription[]
  searchHistory    SearchHistory[]
  bookmarks        Bookmark[]
  notes            Note[]
  locationShares   LocationShare[]
  chatExports      ChatExport[]
  drafts           Draft[]
  autoReply        AutoReply?
  uploadedTracks   MusicTrack[] @relation("MusicUploader")
  musicLikes       MusicLike[]
  playlists        Playlist[]
  developedGames   Game[] @relation("GameDeveloper")
  gameScores       GameScore[]
  referralsMade    Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")
  cloudFiles       CloudFile[]
  cloudFolders     CloudFolder[]
  businessProfile  BusinessProfile?
  badges           UserBadge[]
  sentGifts        SentGift[]    @relation("SentGifts")
  receivedGifts    SentGift[]    @relation("ReceivedGifts")
  sentCards        SentGreetingCard[] @relation("SentCards")
  receivedCards    SentGreetingCard[] @relation("ReceivedCards")
  appPreferences   AppPreference[]
  contactImports   ContactImport[]
  wishlists        Wishlist[]
  loyaltyPoints    LoyaltyPoints?
  loyaltyTxns      LoyaltyTransaction[]
  notificationLogs NotificationLog[]
  // File/media receiving security settings
  blockExecutableFiles Boolean @default(true)
  blockAllFiles        Boolean @default(false)
  blockMediaFromStrangers Boolean @default(false)
  maxFileSize          Int     @default(52428800)
  allowedFileTypes     String[] @default([])
  blockedFileTypes     String[] @default(["apk", "aab", "exe", "msi", "bat", "cmd", "ps1", "sh", "dll", "scr", "com", "vbs", "wsf", "jar", "deb", "rpm", "dmg", "pkg", "app", "ipa", "xapk"])
  autoDownloadMedia    Boolean @default(true)
  autoDownloadOnWifi   Boolean @default(true)
  autoDownloadOnMobile Boolean @default(false)
  failedLoginAttempts  Int     @default(0)
  lockedUntil          DateTime?
  isBanned             Boolean @default(false)
  banReason            String?

  adminAuditLogs AdminAuditLog[] @relation("AdminAuditLogs")

  @@index([username])
  @@index([phone])
  @@index([customStatusExpiresAt])
  @@index([lastSeenAt])
}

// A user-submitted report about another user (optionally about a specific
// message), kept for manual moderation review. Never shown back to users.
enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User         @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversationId String?
  messageId      String?
  reason         ReportReason
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  @@index([reportedUserId])
  @@index([reporterId])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Captured from the User-Agent header at login, shown in the "Active
  // sessions" list to help identify the device.
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  // Bumped each time this session's access token is refreshed.
  lastUsedAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// A previous username a user has changed away from. Keeps the old handle
// reserved for a grace period so it can't be immediately squatted, and lets
// the user view their own change history.
model UsernameHistory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldUsername String
  changedAt   DateTime @default(now())

  @@index([userId])
  @@index([oldUsername])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model Contact {
  id        String        @id @default(uuid())
  ownerId   String
  owner     User          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    User          @relation("ContactTarget", fields: [targetId], references: [id], onDelete: Cascade)
  status    ContactStatus @default(PENDING)
  alias     String?
  isFavorite Boolean      @default(false)
  // Private free-text note the owner keeps about this contact; never shared
  // with the contact or anyone else.
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([ownerId, targetId])
  @@index([ownerId, status])
  @@index([targetId])
  @@index([targetId, status])
}

// One-directional block: ownerId no longer wants contact/messages from blockedId.
model BlockedUser {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("BlockOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, blockedId])
  @@index([ownerId])
  @@index([blockedId])
}

// A user the owner has dismissed from "People you may know" suggestions.
model DismissedSuggestion {
  id              String   @id @default(uuid())
  ownerId         String
  owner           User     @relation("DismissedSuggestionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  dismissedUserId String
  createdAt       DateTime @default(now())

  @@unique([ownerId, dismissedUserId])
  @@index([ownerId])
}

model OnlineNotifyRequest {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("OnlineNotifyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("OnlineNotifyTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, targetId])
  @@index([targetId])
}

// Per-user override of the owner's lastSeenPrivacy setting for one specific
// other user (Telegram-style "Always share with" / "Never share with").
model LastSeenException {
  id              String                @id @default(uuid())
  ownerId         String
  owner           User                  @relation("LastSeenExceptionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  exceptionUserId String
  exceptionUser   User                  @relation("LastSeenExceptionTarget", fields: [exceptionUserId], references: [id], onDelete: Cascade)
  mode            LastSeenExceptionMode
  createdAt       DateTime              @default(now())

  @@unique([ownerId, exceptionUserId])
  @@index([exceptionUserId])
}

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType
  title       String?
  // Group description/announcement, shown to all members.
  description String?
  // Sent as a SYSTEM message to new members when they join the group; null disables it.
  welcomeMessage String?
  avatarUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  pinnedMessages PinnedMessage[]

  // Shareable code allowing anyone to join a GROUP conversation; null means invites are disabled.
  inviteCode String? @unique

  // When set, the invite code stops working after this time.
  inviteCodeExpiresAt DateTime?
  // When set, the invite code stops working after this many successful joins.
  inviteCodeMaxUses   Int?
  // Number of times the current invite code has been used to join.
  inviteCodeUseCount  Int @default(0)

  // New messages auto-delete this many seconds after being sent; null disables it.
  disappearingSeconds Int?

  // GROUP only: when true, only the owner and admins may send messages.
  onlyAdminsCanSend Boolean @default(false)

  // GROUP only: minimum seconds a MEMBER must wait between their messages; 0 disables it.
  slowModeSeconds Int @default(0)

  // GROUP only: when true, MEMBERs can't forward, copy, or export messages from this group.
  noForwards Boolean @default(false)

  // DIRECT only: a "Saved Messages" conversation with a single participant (the owner themself).
  isSelf Boolean @default(false)

  // GROUP only: when true, joining via invite link creates a pending
  // GroupJoinRequest instead of adding the user directly; an owner/admin
  // must approve it.
  requireAdminApproval Boolean @default(false)

  // GROUP only: when true, regular MEMBERs (not just owner/admins) can add new participants.
  membersCanAddMembers Boolean @default(false)

  // GROUP only: when true, regular MEMBERs (not just owner/admins) can pin/unpin messages.
  membersCanPinMessages Boolean @default(false)

  // GROUP only: when true, regular MEMBERs (not just owner/admins) can edit the
  // group's title, photo, and description.
  membersCanChangeInfo Boolean @default(false)

  // GROUP only: when false, regular MEMBERs can only send TEXT messages (no
  // photos, videos, voice notes, files, contacts, or polls).
  membersCanSendMedia Boolean @default(true)

  // GROUP only: when false, regular MEMBERs can't create polls (independent
  // of membersCanSendMedia).
  membersCanSendPolls Boolean @default(true)

  // GROUP only: when true, members who join after this is enabled only see
  // messages sent after they joined (existing members keep their current view).
  hideHistoryForNewMembers Boolean @default(false)

  // GROUP only: when true, regular MEMBERs can't view the full member list
  // (only OWNER/ADMIN can). MEMBERs still see the total member count.
  hideMembersList Boolean @default(false)

  // GROUP only: when false, no one (including admins) can react to messages in this group.
  reactionsEnabled Boolean @default(true)

  participants    ConversationParticipant[]
  messages        Message[]
  joinRequests    GroupJoinRequest[]
  auditLogEntries GroupAuditLogEntry[]
  bans            GroupBan[]
  channelStats    ChannelStats[]
  forumTopics     ForumTopic[]
  isForumEnabled  Boolean @default(false)
  events          Event[]
  channelSubscriptions ChannelSubscription[]
  locationShares  LocationShare[]
  chatExports     ChatExport[]
  drafts          Draft[]
}

enum GroupAuditAction {
  MEMBER_REMOVED
  ROLE_CHANGED
  MEMBER_RESTRICTED
  MEMBER_UNRESTRICTED
  MESSAGE_DELETED
  MEMBER_BANNED
  MEMBER_UNBANNED
  MEMBER_ADDED
  MESSAGE_PINNED
  MESSAGE_UNPINNED
  ALL_MESSAGES_UNPINNED
  GROUP_SETTINGS_CHANGED
  MEMBER_LEFT
  INVITE_LINK_RESET
  INVITE_LINK_REVOKED
}

// GROUP only: a user removed-and-banned from a group by an owner/admin. While
// banned, the user can't rejoin via invite link or be re-added by an admin.
model GroupBan {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bannedUserId   String
  bannedBy       String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, bannedUserId])
  @@index([conversationId])
}

// GROUP only: a log of moderation actions (removals, role changes,
// restrictions, and admins deleting other members' messages), visible to the
// group's owner and admins via the "Recent actions" screen.
model GroupAuditLogEntry {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId        String
  targetUserId   String?
  action         GroupAuditAction
  details        String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// A pending request to join a GROUP via invite link when the group requires
// admin approval. Holds the wrapped conversation key the requester generated
// client-side, applied to a new ConversationParticipant once approved.
model GroupJoinRequest {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  wrappedKey         String
  wrappedKeyNonce    String
  keySenderPublicKey String

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

// Stores the conversation's shared symmetric key, individually wrapped
// (encrypted) for each participant's public key (NaCl box). The server
// never has access to the unwrapped symmetric key or message plaintext.
model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)

  // base64 NaCl box: secretbox(conversationKey) encrypted to this user's publicKey
  wrappedKey         String
  wrappedKeyNonce    String
  // public key of whoever performed the wrapping (needed to open the box)
  keySenderPublicKey String

  joinedAt     DateTime  @default(now())
  lastReadAt   DateTime?
  // Last time this participant's device received/synced messages in this
  // conversation - used to show "delivered" (gray double-check) ticks to the sender.
  lastDeliveredAt DateTime?
  // True when this conversation is muted indefinitely ("Doimiy").
  isMuted      Boolean   @default(false)
  // When set and in the future, this conversation is muted until this time.
  mutedUntil   DateTime?
  pinnedAt     DateTime?
  // Manual sort position among this user's pinned conversations (lower
  // sorts first). Null means it hasn't been manually reordered yet, so it
  // falls back to pinnedAt-based ordering.
  pinnedOrder  Int?
  isArchived   Boolean   @default(false)
  // User manually flagged this conversation as unread; cleared on next markRead.
  markedUnread Boolean   @default(false)
  // Messages created at or before this time are hidden from this user only.
  clearedAt    DateTime?
  // Set when this user "deletes" the conversation from their chat list (its
  // history is cleared too). The conversation reappears once a message newer
  // than this arrives.
  hiddenAt     DateTime?
  // When set, this chat is auto-removed from this user's chat list (like
  // `deleteConversation`) once this many seconds pass with no new message
  // after `conversation.updatedAt`. Null means auto-delete is off.
  autoDeleteAfterSeconds Int?
  // GROUP only: when set and in the future, this MEMBER cannot send messages
  // until this time (admin-imposed restriction).
  restrictedUntil DateTime?
  // GROUP only: optional custom label shown instead of "Admin"/"Owner" for this
  // participant (e.g. "Moderator"). Settable by the group owner.
  customTitle     String?
  // Per-conversation override of this user's global hideNotificationContent setting.
  notificationPreview NotificationPreview @default(DEFAULT)
  // Per-conversation override of this user's global readReceiptsEnabled setting.
  readReceiptsOverride ReadReceiptsOverride @default(DEFAULT)
  // GROUP only: userIds of other participants whose messages shouldn't trigger
  // notifications for this user (not enforced as a foreign key; stale IDs from
  // removed members are simply ignored).
  mutedSenderIds String[] @default([])

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, pinnedAt, pinnedOrder])
  @@index([userId, isArchived])
  @@index([userId, isMuted])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType  @default(TEXT)

  // base64 NaCl secretbox ciphertext, encrypted client-side with the
  // conversation's symmetric key. The server stores opaque bytes only.
  ciphertext String
  nonce      String

  // for IMAGE/VIDEO/AUDIO/FILE: URL to the (also encrypted) media blob
  mediaUrl String?

  // LOCATION only: coordinates sent as plaintext metadata so the server
  // can render static map previews; actual address text is in ciphertext.
  latitude  Float?
  longitude Float?

  // user IDs of @-mentioned participants (sent in cleartext alongside the
  // ciphertext so the server can route mention notifications)
  mentions String[] @default([])

  // When set, this message was forwarded from another conversation; holds the
  // original sender's display name (sent in cleartext for the "Forwarded" label).
  forwardedFromName String?
  // Original sender's user id, so the "Forwarded from" label can link to their profile.
  forwardedFromUserId String?
  // Number of hops this message has been forwarded along its chain. 0 = not
  // forwarded, 1 = single forward (shows "Forwarded from X"), 2+ = forwarded
  // multiple times (shows the generic "Forwarded many times" label instead).
  forwardCount Int @default(0)

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  reactions   MessageReaction[]
  stars       MessageStar[]
  pollVotes   PollVote[]
  pins        PinnedMessage[]
  editHistory MessageEditHistory[]
  reminders   MessageReminder[]
  translations TranslationCache[]
  bookmarks    Bookmark[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  // When set (based on the conversation's disappearing-messages setting at send
  // time), the message is auto-deleted once this time passes.
  expiresAt DateTime?

  // When set and in the future, this message is not yet delivered: it's hidden
  // from other participants until a background job "publishes" it at this time.
  scheduledFor DateTime?

  // DIRECT only: when true, this message (held pending via scheduledFor with a
  // far-future placeholder) is delivered as soon as the recipient comes online,
  // instead of at a fixed time.
  sendWhenOnline Boolean @default(false)

  // User IDs who chose "delete for me": the message is hidden from their view
  // only, other participants are unaffected.
  hiddenFor String[] @default([])

  // "View once" media (IMAGE only): the media is deleted server-side after the
  // recipient views it once.
  viewOnce Boolean   @default(false)
  viewedAt DateTime?

  // Media (IMAGE or VIDEO) sent with a blur overlay; recipients must tap to
  // reveal. Unlike viewOnce, the media is not deleted and can be re-hidden.
  isSpoiler Boolean @default(false)

  // POLL only: when true, other participants' identities are hidden from each
  // other's pollVotes - only vote counts and the viewer's own vote are visible.
  pollAnonymous Boolean @default(false)

  // POLL only: when set, the poll creator has closed voting - no further
  // votes are accepted and clients show the final results as read-only.
  pollClosedAt DateTime?

  // POLL only: when set, a background job auto-closes the poll (sets
  // pollClosedAt and clears this field) once this time passes.
  pollClosesAt DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, type])
  @@index([senderId])
  @@index([replyToId])
  @@index([expiresAt])
  @@index([scheduledFor])
  @@index([pollClosesAt])
  @@index([expiresAt, deletedAt])
  @@index([scheduledFor, sendWhenOnline])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// Snapshot of a message's content before it was overwritten by an edit, so
// participants can review what a message used to say.
model MessageEditHistory {
  id         String   @id @default(uuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ciphertext String
  nonce      String
  editedAt   DateTime

  @@index([messageId])
}

// Per-user "favorite" flag on a message (WeChat-style starred messages).
// Not shared with other participants.
model MessageStar {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

// A user's reminder ("Yodga solish") to revisit a specific message later.
// A background job notifies the user once remindAt passes, then deletes the row.
model MessageReminder {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([remindAt])
  @@index([userId, remindAt])
}

// A user's vote(s) on a POLL message. The poll question and option text are
// part of the message's E2EE ciphertext; the server only sees which opaque
// option IDs each user picked, so it can tally and broadcast results.
model PollVote {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
}

// A message pinned to the top of a conversation. A conversation may have
// multiple pinned messages, shown most-recently-pinned first.
model PinnedMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy       String
  pinnedAt       DateTime     @default(now())
  // When set, this pin is automatically removed once this time passes.
  expiresAt      DateTime?

  @@unique([conversationId, messageId])
  @@index([conversationId, pinnedAt])
  @@index([expiresAt])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

// User-defined chat list tabs (Telegram-style folders), e.g. "Ish", "Oila".
model ChatFolder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  // Optional emoji icon shown next to the folder name in the chat list tab bar.
  icon   String?
  order  Int    @default(0)
  // IDs of conversations included in this folder. Not enforced as a foreign key;
  // stale IDs (e.g. for left groups) are simply filtered out client-side.
  conversationIds String[] @default([])
  createdAt       DateTime @default(now())

  // Smart filters (Telegram-style): in addition to conversationIds, automatically
  // include conversations matching any of these criteria.
  includeUnread Boolean @default(false)
  includeGroups Boolean @default(false)
  includeDirect Boolean @default(false)
  // Excludes muted conversations from this folder, including manually added ones.
  excludeMuted  Boolean @default(false)

  @@index([userId])
}

// A named list of recipients (WhatsApp-style "broadcast list"): sending a
// message to the list delivers it as an individual direct message to each
// member's 1:1 conversation with the owner - members are unaware of each other.
model BroadcastList {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  // IDs of recipient users. Not enforced as a foreign key; stale IDs (e.g. for
  // deleted accounts) are simply filtered out client-side.
  memberIds String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

