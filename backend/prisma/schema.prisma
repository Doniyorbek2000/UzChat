  conversationId  String
  addedAt         DateTime  @default(now())

  @@unique([communityId, conversationId])
  @@index([communityId])
}

model Event {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  location        String?
  startAt         DateTime
  endAt           DateTime?
  isAllDay        Boolean  @default(false)
  color           String   @default("#007AFF")
  reminderMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  rsvps EventRsvp[]

  @@index([conversationId])
  @@index([creatorId])
  @@index([startAt])
}

model EventRsvp {
  id       String @id @default(uuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   String @default("going")
  respondedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model TranslationCache {
  id         String @id @default(uuid())
  messageId  String
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fromLang   String
  toLang     String
  original   String
  translated String
  createdAt  DateTime @default(now())

  @@unique([messageId, toLang])
  @@index([messageId])
}

model ChannelSubscription {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            String   @default("basic")
  price           Decimal  @default(0) @db.Decimal(18, 2)
  currency        String   @default("UZS")
  isActive        Boolean  @default(true)
  startedAt       DateTime @default(now())
  expiresAt       DateTime?
  cancelledAt     DateTime?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  type      String   @default("message")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  label     String?
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId, createdAt])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  color     String   @default("#FFF9C4")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, createdAt])
}

model LocationShare {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  latitude        Float
  longitude       Float
  isLive          Boolean  @default(false)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([conversationId])
  @@index([userId])
  @@index([expiresAt])
}

model ChatExport {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  format          String   @default("txt")
  includeMedia    Boolean  @default(false)
  status          String   @default("pending")
  fileUrl         String?
  messageCount    Int      @default(0)
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([conversationId])
}

model Draft {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content         String
  replyToId       String?
  attachments     String[] @default([])
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([userId, conversationId])
  @@index([userId])
}

model AutoReply {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled Boolean  @default(false)
  message   String
  startAt   DateTime?
  endAt     DateTime?
  onlyForStrangers Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId])
}

model MusicTrack {
  id          String   @id @default(uuid())
  title       String
  artist      String
  albumTitle  String?
  coverUrl    String?
  audioUrl    String
  duration    Int
  genre       String?
  uploaderId  String
  uploader    User     @relation("MusicUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  playCount   Int      @default(0)
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())

  likes       MusicLike[]
  playlists   PlaylistTrack[]

  @@index([uploaderId])
  @@index([playCount])
}

model MusicLike {
  id       String     @id @default(uuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId  String
  track    MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, trackId])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tracks PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String     @id @default(uuid())
  playlistId String
  playlist   Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int        @default(0)
  addedAt    DateTime   @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

model Game {
  id          String   @id @default(uuid())
  title       String
  description String?
  iconUrl     String?
  url         String
  category    String   @default("casual")
  developerId String
  developer   User     @relation("GameDeveloper", fields: [developerId], references: [id], onDelete: Cascade)
  playCount   Int      @default(0)
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  scores GameScore[]

  @@index([developerId])
  @@index([playCount])
  @@index([category])
}

model GameScore {
  id       String   @id @default(uuid())
  gameId   String
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score    Int
  playedAt DateTime @default(now())

  @@index([gameId, score])
  @@index([userId])
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  referrer      User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String
  referred      User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  code          String
  rewardAmount  Decimal  @default(0) @db.Decimal(18, 2)
  rewardClaimed Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([code])
}

model CloudFile {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  path      String
  mimeType  String
  size      Int
  url       String
  folderId  String?
  folder    CloudFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, folderId])
}

model CloudFolder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    CloudFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  CloudFolder[] @relation("FolderTree")
  files     CloudFile[]
  createdAt DateTime @default(now())

  @@index([userId, parentId])
}

model BusinessProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  category      String
  description   String?
  address       String?
  phone         String?
  email         String?
  website       String?
  workingHours  String?
  coverUrl      String?
  isVerified    Boolean  @default(false)
  autoReplyMsg  String?
  greetingMsg   String?
  catalogEnabled Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())

  posts     HashtagPost[]
}

model HashtagPost {
  id        String   @id @default(uuid())
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  postId    String
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([hashtagId, postId])
  @@index([hashtagId])
  @@index([postId])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     String
  label     String
  icon      String
  earnedAt  DateTime @default(now())

  @@unique([userId, badge])
  @@index([userId])
}

model VirtualGift {
  id          String   @id @default(uuid())
  name        String
  icon        String
  price       Int
  category    String   @default("general")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  sentGifts   SentGift[]
}

model SentGift {
  id         String      @id @default(uuid())
  giftId     String
  gift       VirtualGift @relation(fields: [giftId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation("SentGifts", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User        @relation("ReceivedGifts", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String?
  createdAt  DateTime    @default(now())

  @@index([giftId])
  @@index([senderId])
  @@index([receiverId])
}

model GreetingCard {
  id           String   @id @default(uuid())
  templateName String
  category     String
  imageUrl     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  sentCards    SentGreetingCard[]
}

model SentGreetingCard {
  id         String       @id @default(uuid())
  cardId     String
  card       GreetingCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User         @relation("SentCards", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User         @relation("ReceivedCards", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String?
  createdAt  DateTime     @default(now())

  @@index([cardId])
  @@index([senderId])
  @@index([receiverId])
}

model AppPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model ContactImport {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneHash   String
  matchedUserId String?
  displayName String?
  createdAt   DateTime @default(now())

  @@unique([userId, phoneHash])
  @@index([userId])
  @@index([phoneHash])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model LoyaltyPoints {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  level     String   @default("bronze")
  updatedAt DateTime @default(now()) @updatedAt
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      String
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model FaqArticle {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([category])
}

model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

// ─── SECURITY: LOGIN ATTEMPTS ───────────────────────────────

model LoginAttempt {
  id        String   @id @default(uuid())
  phone     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

// ─── ADMIN AUDIT LOG ────────────────────────────────────────

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  admin       User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action      String
  targetType  String?
  targetId    String?
  details     String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action])
  @@index([targetId])
}
