generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
}

enum ContactStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  bio          String?
  // Base64 X25519 public key used by clients for end-to-end encryption.
  // The matching private key never leaves the user's device.
  publicKey    String
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  participants     ConversationParticipant[]
  messages         Message[]
  sentContacts     Contact[]                  @relation("ContactOwner")
  receivedContacts Contact[]                  @relation("ContactTarget")

  @@index([username])
  @@index([phone])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Contact {
  id        String        @id @default(uuid())
  ownerId   String
  owner     User          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    User          @relation("ContactTarget", fields: [targetId], references: [id], onDelete: Cascade)
  status    ContactStatus @default(PENDING)
  alias     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([ownerId, targetId])
  @@index([targetId])
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType
  title     String?
  avatarUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

// Stores the conversation's shared symmetric key, individually wrapped
// (encrypted) for each participant's public key (NaCl box). The server
// never has access to the unwrapped symmetric key or message plaintext.
model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)

  // base64 NaCl box: secretbox(conversationKey) encrypted to this user's publicKey
  wrappedKey         String
  wrappedKeyNonce    String
  // public key of whoever performed the wrapping (needed to open the box)
  keySenderPublicKey String

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType  @default(TEXT)

  // base64 NaCl secretbox ciphertext, encrypted client-side with the
  // conversation's symmetric key. The server stores opaque bytes only.
  ciphertext String
  nonce      String

  // for IMAGE/VIDEO/AUDIO/FILE: URL to the (also encrypted) media blob
  mediaUrl String?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}
