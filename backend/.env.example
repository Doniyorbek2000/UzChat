NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://uzchat:uzchat@localhost:5432/uzchat?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS provider: "log" (development) or "eskiz" (production via eskiz.uz)
SMS_PROVIDER=log
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_FROM=4546

CORS_ORIGIN=http://localhost:8081

# Base URL the backend is reachable at; used to build absolute /media file URLs
PUBLIC_URL=http://localhost:4000

# Self-service wallet top-up. Keep "false" until a real payment provider
# (Payme/Click/Uzum) is connected — "true" lets users credit themselves freely.
# Admins can always credit wallets via POST /admin/users/:id/wallet-credit.
PAYMENTS_TOPUP_ENABLED=false
