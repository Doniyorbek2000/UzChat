NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://uzchat:uzchat@localhost:5432/uzchat?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS provider: "log" (development) or "eskiz" (production via eskiz.uz)
SMS_PROVIDER=log
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_FROM=4546

CORS_ORIGIN=http://localhost:8081

# Base URL the backend is reachable at; used to build absolute /media file URLs
PUBLIC_URL=http://localhost:4000

# Self-service wallet top-up. Keep "false" until a real payment provider
# (Payme/Click/Uzum) is connected — "true" lets users credit themselves freely.
# Admins can always credit wallets via POST /admin/users/:id/wallet-credit.
PAYMENTS_TOPUP_ENABLED=false

# Media storage: "local" (single-node disk) or "s3" (MinIO/R2/AWS S3 —
# required when running more than one backend replica).
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uzchat-media
S3_ACCESS_KEY_ID=uzchat
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
# CDN or public bucket base URL for downloads; leave empty to proxy via /media
S3_PUBLIC_URL=

# Bearer token for GET /metrics (Prometheus). Empty disables the endpoint.
METRICS_TOKEN=

# Sentry DSN for server exception tracking. Empty = disabled (errors still logged).
SENTRY_DSN=
APP_VERSION=1.0.0

# Extra comma-separated blocked terms for public-content moderation.
MODERATION_EXTRA_BLOCKED=
