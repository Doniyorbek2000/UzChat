# PostgreSQL
POSTGRES_PASSWORD=change-me-to-a-strong-password

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-hex
JWT_REFRESH_SECRET=replace-with-different-random-hex

# SMS provider: "log" (dev) or "eskiz" (production via eskiz.uz)
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_FROM=4546

# Domain
CORS_ORIGIN=https://uzchat.app
PUBLIC_URL=https://uzchat.app
