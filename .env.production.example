# PostgreSQL
POSTGRES_PASSWORD=change-me-to-a-strong-password

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-hex
JWT_REFRESH_SECRET=replace-with-different-random-hex

# SMS provider: "log" (dev) or "eskiz" (production via eskiz.uz)
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_FROM=4546

# Domain
CORS_ORIGIN=https://uzchat.app
PUBLIC_URL=https://uzchat.app

# Media storage: "local" (single-node disk) or "s3" (MinIO/R2/AWS S3 —
# required when running more than one backend replica).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=uzchat-media
S3_ACCESS_KEY_ID=uzchat
S3_SECRET_ACCESS_KEY=change-me-to-a-strong-minio-password
S3_FORCE_PATH_STYLE=true
# CDN or public bucket base URL for downloads; leave empty to proxy via /media
S3_PUBLIC_URL=

# Bearer token for GET /metrics (Prometheus). Empty disables the endpoint.
METRICS_TOKEN=change-me-to-a-random-token
